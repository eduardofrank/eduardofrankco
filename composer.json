{
	"name": "typo3/cms-base-distribution",
	"description" : "TYPO3 CMS Base Distribution",
	"license": "GPL-2.0-or-later",
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	},
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.typo3.org/"
        },
        {
            "type": "path",
            "url": "packages/efrank14"
        }
    ],
	"require": {
		"codingms/fluid-fpdf": "^3.0",
		"codingms/parsedown-extra": "^5.0",
		"eduardo-frank/efrank14": "@dev",
		"helhum/typo3-console": "^8.3",
		"netresearch/rte-ckeditor-image": "^13.0",
		"t3g/blog": "^14.0",
		"typo3/cms-adminpanel": "^14.0",
		"typo3/cms-backend": "^14.0",
		"typo3/cms-belog": "^14.0",
		"typo3/cms-beuser": "^14.0",
		"typo3/cms-core": "^14.0",
		"typo3/cms-dashboard": "^14.0",
		"typo3/cms-extbase": "^14.0",
		"typo3/cms-extensionmanager": "^14.0",
		"typo3/cms-felogin": "^14.0",
		"typo3/cms-filelist": "^14.0",
		"typo3/cms-filemetadata": "^14.0",
		"typo3/cms-fluid": "^14.0",
		"typo3/cms-form": "^14.0",
		"typo3/cms-frontend": "^14.0",
		"typo3/cms-impexp": "^14.0",
		"typo3/cms-info": "^14.0",
		"typo3/cms-install": "^14.0",
		"typo3/cms-linkvalidator": "^14.0",
		"typo3/cms-lowlevel": "^14.0",
		"typo3/cms-opendocs": "^14.0",
		"typo3/cms-recordlist": "^14.0",
		"typo3/cms-recycler": "^14.0",
		"typo3/cms-redirects": "^14.0",
		"typo3/cms-reports": "^14.0",
		"typo3/cms-rte-ckeditor": "^14.0",
		"typo3/cms-scheduler": "^14.0",
		"typo3/cms-seo": "^14.0",
		"typo3/cms-setup": "^14.0",
		"typo3/cms-sys-note": "^14.0",
		"typo3/cms-tstemplate": "^14.0",
