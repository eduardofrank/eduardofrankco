# Code highlighting theme
page.includeCSS.prism = EXT:parsedown_extra/Resources/Public/Contrib/PrismJs/prism.css
page.includeCSS.prism {
	external = 0
	disableCompression = 1
	excludeFromConcatenation = 1
}

# Code highlighting Scripts
page.includeJSFooter.prism = EXT:parsedown_extra/Resources/Public/Contrib/PrismJs/prism.js
page.includeJSFooter.prism {
	external = 0
	disableCompression = 1
	excludeFromConcatenation = 1
	type = text/javascript
	forceOnTop = 1
}

page.includeJSFooter.prismTypoScript = EXT:parsedown_extra/Resources/Public/Contrib/PrismJs/Languages/typoscript.js
page.includeJSFooter.prismTypoScript {
	external = 0
	disableCompression = 1
	excludeFromConcatenation = 1
	type = text/javascript
}

page.includeJSFooterlibs.clipboard = EXT:parsedown_extra/Resources/Public/Contrib/ClipboardJs/clipboard.min.js
page.includeJSFooterlibs.clipboard {
	external = 0
	disableCompression = 1
	excludeFromConcatenation = 1
	type = text/javascript
}
