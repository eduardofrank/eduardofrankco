#############################################
# Colorbox: Lightbox constants
#############################################

# cat=lightbox; type=options[0,1]; label=LLL:EXT:parsedown_extra/Resources/Private/Language/locallang_constants.xlf:tx_parsedownextra_constants.lightbox_enabled
styles.content.imgtext.linkWrap.lightboxEnabled = 1

# cat=basic; type=string; label=LLL:EXT:parsedown_extra/Resources/Private/Language/locallang_constants.xlf:tx_parsedownextra_constants.lightbox_css_class
styles.content.imgtext.linkWrap.lightboxCssClass = lightbox

# cat=basic; type=string; label=LLL:EXT:parsedown_extra/Resources/Private/Language/locallang_constants.xlf:tx_parsedownextra_constants.lightbox_rel_attribute
styles.content.imgtext.linkWrap.lightboxRelAttribute = lightbox[{field:uid}]

# cat=lightbox; type=options[1,2,3,4,5]; label=LLL:EXT:parsedown_extra/Resources/Private/Language/locallang_constants.xlf:tx_parsedownextra_constants.lightbox_theme
themes.configuration.lightbox.colorbox.theme = 2

# cat=basic; type=string; label=LLL:EXT:parsedown_extra/Resources/Private/Language/locallang_constants.xlf:tx_parsedownextra_constants.cssUrl
themes.configuration.lightbox.colorbox.cssUrl = https://cdnjs.cloudflare.com/ajax/libs/jquery.colorbox/1.4.33/

# cat=basic; type=string; label=LLL:EXT:parsedown_extra/Resources/Private/Language/locallang_constants.xlf:tx_parsedownextra_constants.jsUrl
themes.configuration.lightbox.colorbox.jsUrl = https://cdnjs.cloudflare.com/ajax/libs/jquery.colorbox/1.4.33/
