# LightBox theme
page.includeCSS.lightbox = {$themes.configuration.lightbox.colorbox.cssUrl}example{$themes.configuration.lightbox.colorbox.theme}/colorbox.min.css
page.includeCSS.lightbox.external = 1
page.includeCSS.lightbox.disableCompression = 1
page.includeCSS.lightbox.excludeFromConcatenation = 1

# LightBox Scripts
page.includeJSFooter.lightbox = {$themes.configuration.lightbox.colorbox.jsUrl}jquery.colorbox-min.js
page.includeJSFooter.lightbox.external = 1
page.includeJSFooter.lightbox.disableCompression = 1
page.includeJSFooter.lightbox.excludeFromConcatenation = 1
page.includeJSFooter.lightbox.type = text/javascript

# Bind LightBoxes
page {
	jsFooterInline {
		1498747587 = TEXT
		1498747587.value (
			jQuery(document).ready(function() {
				jQuery('.tx-parsedown-extra img[rel=\'enlarge-image\']').each(function() {
					var anchor = jQuery('<a/>').attr({'href': this.src}).colorbox({title: this.title, rel:'enlarge-image'});
					jQuery(this).wrap(anchor);
				});
			});
		)
	}
}
