@import 'EXT:fluid_fpdf/Configuration/PageTS/Library/'

mod.wizards.newContentElement.wizardItems {
	pdf {
		show = *
		header = LLL:EXT:fluid_fpdf/Resources/Private/Language/locallang_newcontentelementwizard.xlf:tx_fluidfpdf_newcontentelementwizard_pdf.header
		elements {
			fluidfpdf_pdf {
				iconIdentifier = content-plugin-fluidfpdf-pdf
				title = LLL:EXT:fluid_fpdf/Resources/Private/Language/locallang_newcontentelementwizard.xlf:tx_fluidfpdf_newcontentelementwizard_pdf.title
				description = LLL:EXT:fluid_fpdf/Resources/Private/Language/locallang_newcontentelementwizard.xlf:tx_fluidfpdf_newcontentelementwizard_pdf.description
				tt_content_defValues {
					CType = fluidfpdf_pdf
				}
			}
		}
	}
}
